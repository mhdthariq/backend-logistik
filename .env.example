# Set these in the process environment; no .env loader is installed.
HOST=127.0.0.1
PORT=8080
SHUTDOWN_TIMEOUT=10s
# Business routes activate when DATABASE_URL or LICENSE_API_URL is set.
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/novalogistik?schema=public
NODE_ENV=development
PREVIEW_MODE=false
NEXT_PUBLIC_COMPANY_NAME=NovaLogistik
TENANT_MAX_POOLS=32
TENANT_MAX_CONNECTIONS=4
# Corporate license lookup (all four values required outside development).
LICENSE_API_URL=
LICENSE_API_KEY=
LICENSE_API_TOKEN=
LICENSE_APLIKASI=
MOBILE_ANDROID_MIN_VERSION_CODE=1
MOBILE_ANDROID_LATEST_VERSION_CODE=1
MOBILE_DISTRIBUTION=private
